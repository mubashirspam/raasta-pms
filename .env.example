# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Get this from: https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate a 64-char random secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-64-char-random-string

# ─── App URL (used by Better Auth and CORS) ───────────────────────────────────
# Development:
BETTER_AUTH_URL=http://localhost:3000
# Production (replace with your Vercel domain):
# BETTER_AUTH_URL=https://your-app.vercel.app

# ─── Next.js ──────────────────────────────────────────────────────────────────
NODE_ENV=development
